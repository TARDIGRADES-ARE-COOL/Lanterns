# Green Lantern (unofficial fan project) settings. Copy this file to .env and add AT LEAST ONE key.
# Never commit or share .env.

# --- Free (no credit card) -------------------------------------------------
# With only free keys, `ring forge "..."` automatically uses the free chain:
# it tries free models best-first and skips any that are used up or busy.
GEMINI_API_KEY=            # best free quality: https://aistudio.google.com/apikey
GROQ_API_KEY=              # very fast, separate limits: https://console.groq.com/keys

# --- Claude (paid, best quality) -------------------------------------------
# If this is set, Claude is the default. Use --provider free to stay free.
ANTHROPIC_API_KEY=         # https://console.anthropic.com

# --- Optional ---------------------------------------------------------------
# RING_PROVIDER=free       # force a default: free | anthropic | gemini | groq
# RING_EFFORT=low          # Claude: low | medium | high | xhigh | max
# RING_MODEL=              # a specific model, e.g. claude-sonnet-5-5
# RING_PORT=8765           # viewer port
